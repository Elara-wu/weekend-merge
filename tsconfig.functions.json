{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["netlify/functions/**/*.ts", "src/contracts/**/*.ts", "src/demo/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
